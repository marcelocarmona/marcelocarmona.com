{
  "name": "marcelocarmona-website",
  "version": "1.5.6",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.13.0": true
  },
  "scripts": {
    "start": "next start",
    "dev": "next dev",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "build:webpack": "next build --webpack",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "lint": "eslint --fix --ext .ts,.tsx app components lib layouts scripts tests proxy.ts",
    "lint:check": "eslint --ext .ts,.tsx app components lib layouts scripts tests proxy.ts",
    "test": "vitest run",
    "isometric-ba:fetch": "bash scripts/isometric-ba/fetch-data.sh",
    "isometric-ba:preprocess": "node scripts/isometric-ba/preprocess-tejido.mts && node scripts/isometric-ba/preprocess-osm.mts && node scripts/isometric-ba/preprocess-trees.mts",
    "isometric-ba:render": "node scripts/isometric-ba/render.mts --quality=70",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource-variable/spline-sans-mono": "^5.3.0",
    "@sentry/nextjs": "^11.11.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.5",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.2",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "image-size": "^2.1.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^6.17.0",
    "mdx-bundler": "^10.1.1",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-pretty-code": "^0.14.6",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.2.4",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@next/bundle-analyzer": "^16.4.6",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "dedent": "^1.7.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "inquirer": "^14.2.5",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "katex": "^0.18.2",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "mdx-bundler": {
      "uuid": "^11.1.1"
    },
    "remark-mdx-frontmatter": {
      "toml": "^5.0.1"
    }
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
