{
  "name": "inkpulse",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "server"
  ],
  "scripts": {
    "start": "npm run start --workspace=@inkpulse/server",
    "test": "npm run test --workspace=@inkpulse/server",
    "test:server": "npm run test --workspace=@inkpulse/server",
    "test:all": "npm run test:server && npm run firmware:test",
    "firmware:setup": "python3 -m venv firmware/.venv && firmware/.venv/bin/python -m pip install -r firmware/requirements.txt",
    "firmware:build": "firmware/.venv/bin/platformio run --project-dir firmware --environment inkpulse_7in5",
    "firmware:test": "cd firmware && .venv/bin/platformio test --environment native"
  },
  "engines": {
    "node": ">=22.9"
  }
}
