# All settings are optional. The server automatically discovers your Mac's LAN address.
TRMNL_TIME_ZONE=America/Los_Angeles
TRMNL_MESSAGE=Hello from your TRMNL!

# How often the device should request a new screen, in seconds.
TRMNL_REFRESH_SECONDS=300

# Set this only if automatic LAN address detection is wrong.
# TRMNL_PUBLIC_URL=http://192.168.1.50:3000

# The local port used by the server.
PORT=3000
